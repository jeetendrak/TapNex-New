# ==============================================================================
# TapNex NFC Smart Business Card Platform - Environment Configuration
# Copy to .env for local development. Never commit real secrets to GitHub.
# ==============================================================================

# --- Public Client Variables (Safe for Netlify / Vite Frontend) ---
VITE_APP_NAME="TapNex"
VITE_APP_URL="http://localhost:3000"

# Optional overrides if not using firebase-applet-config.json
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_RECAPTCHA_SITE_KEY=""

# Razorpay Public Key ID (Test or Live key_id only - NEVER put key_secret here)
VITE_RAZORPAY_KEY_ID=""

# --- Server-Side Secrets (Express Server / Firebase Cloud Functions Only) ---
APP_URL="http://localhost:3000"
GEMINI_API_KEY=""

# Razorpay Server Credentials
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cashfree Server Credentials
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""

# Easebuzz Server Credentials
EASEBUZZ_MERCHANT_KEY=""
EASEBUZZ_SALT=""

# PayU India Server Credentials
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""

# Google Pay Business / Merchant ID (Server/Public Merchant Identifier)
GOOGLE_PAY_MERCHANT_ID=""

# Transactional Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TapNex <orders@yourdomain.com>"

# One-Time Initial SuperAdmin Bootstrap Credentials (Server-side only; disable after init)
SUPERADMIN_BOOTSTRAP_ENABLED="false"
SUPERADMIN_INITIAL_USERNAME="superadmin"
SUPERADMIN_INITIAL_EMAIL="superadmin@yourdomain.com"
SUPERADMIN_INITIAL_PASSWORD=""

# Firebase Admin SDK (Optional JSON service account for Cloud Run / Express server)
FIREBASE_SERVICE_ACCOUNT_JSON=""
